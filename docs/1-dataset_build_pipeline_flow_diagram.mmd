flowchart TD
  A["build_dataset.py"] --> B["parse_args()"]
  B --> C{"--refresh-nvd?"}

  C -->|Yes| D["NVDClient.fetch_cves()"]
  D --> E["NVDRecordNormalizer.normalize_many()"]
  E --> F["Filter records with products + versions"]
  F --> G["Save data/knowledge_base/cves.json"]

  C -->|No| H{"Does cves.json exist?"}
